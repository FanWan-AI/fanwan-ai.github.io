{
  "name": "fanwan-ai.github.io",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "blog:translate": "node scripts/translate-markdown.mjs",
    "og:render": "node scripts/render-all-og.mjs",
    "blog:build": "node scripts/generate-blog.mjs",
    "blog:build:one": "node scripts/generate-blog.mjs",
    "og:from-template": "node scripts/generate-og-from-template.mjs",
    "og:rasterize": "node scripts/rasterize-og.mjs",
    "blog:index": "node scripts/build-blog-index.mjs",
    "rss": "node scripts/generate-rss.mjs",
    "site:build": "npm run blog:translate && npm run og:from-template && npm run og:rasterize || true && npm run og:render || true && npm run blog:build && npm run blog:index && npm run rss && npm run daily:post",
    "serve": "npx http-server -p 8080 -c-1 .",
    "i18n:fill": "node tools/translate.mjs",
    "academy:generate": "node tools/academy/generate-daily.mjs",
    "academy:generate:dry": "node tools/academy/generate-daily.mjs --dry-run",
    "academy:validate": "node tools/academy/validate.mjs",
    "academy:tts": "python tools/academy/tts_daily.py",
    "academy:daily": "npm run academy:generate && npm run academy:validate && npm run academy:tts",
    "modelswatch:tag:dry": "python tools/modelswatch_tagging.py --dry-run",
    "modelswatch:tag": "python tools/modelswatch_tagging.py",
    "modelswatch:tag:llm": "python tools/modelswatch_tagging.py --use-llm",
    "daily:post": "npm run modelswatch:tag",
    "check:hashes": "node tools/modelswatch/previous_js/check_hash_compat.mjs",
    "modelswatch:audit:maintain": "node tools/modelswatch/maintain_audit.mjs",
    "modelswatch:data:archive": "node tools/modelswatch/archive_data.mjs",
    "validate:wealth": "node tools/wealth/validate.mjs",
    "dryrun:daily": "node tools/wealth/generate-daily.mjs --dry-run",
    "dryrun:pulse": "node tools/wealth/generate-pulse.mjs --dry-run"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "http-server": "^14.1.1",
    "puppeteer": "^22.15.0",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "jsonrepair": "^3.6.0",
    "rss-parser": "^3.13.0"
  }
}
