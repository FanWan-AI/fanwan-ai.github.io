{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanwan-ai.github.io/schema/startup-opportunity-daily.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "date", "generated_at", "editorial_note", "opportunities", "sources", "quality"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "startup_opportunity_daily" },
    "date": { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["published"] },
    "headline": { "type": "string", "minLength": 8, "maxLength": 300 },
    "editorial_note": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "opportunities": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/opportunity" } },
    "sources": { "type": "array", "items": { "$ref": "https://fanwan-ai.github.io/schema/startup-source.json" } },
    "quality": { "$ref": "#/$defs/quality" },
    "pipeline_version": { "type": "string" }
  },
  "$defs": {
    "opportunity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rank", "depth", "title", "verdict", "customer", "pain", "why_now", "evidence", "ai_advantage", "smallest_sellable_product", "business_model", "failure_modes", "falsification_test", "score", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9\u4e00-\u9fff][a-z0-9\u4e00-\u9fff-]{2,79}$" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
        "depth": { "enum": ["deep", "brief"] },
        "title": { "type": "string", "minLength": 8, "maxLength": 180 },
        "verdict": { "type": "string", "minLength": 20, "maxLength": 500 },
        "customer": { "type": "string", "minLength": 8, "maxLength": 300 },
        "pain": { "type": "string", "minLength": 20, "maxLength": 800 },
        "why_now": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["claim", "source_ids", "confidence"], "properties": { "claim": { "type": "string", "minLength": 8, "maxLength": 500 }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "confidence": { "enum": ["high", "medium", "low"] } } } },
        "ai_advantage": { "type": "string", "minLength": 20, "maxLength": 700 },
        "smallest_sellable_product": { "type": "string", "minLength": 20, "maxLength": 700 },
        "business_model": { "type": "string", "minLength": 15, "maxLength": 500 },
        "failure_modes": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 8, "maxLength": 400 } },
        "falsification_test": { "type": "string", "minLength": 20, "maxLength": 500 },
        "score": { "type": "object", "additionalProperties": false, "required": ["total", "pain", "timing", "evidence", "ai_fit", "reachability"], "properties": { "total": { "type": "integer", "minimum": 0, "maximum": 100 }, "pain": { "type": "integer", "minimum": 0, "maximum": 25 }, "timing": { "type": "integer", "minimum": 0, "maximum": 20 }, "evidence": { "type": "integer", "minimum": 0, "maximum": 20 }, "ai_fit": { "type": "integer", "minimum": 0, "maximum": 20 }, "reachability": { "type": "integer", "minimum": 0, "maximum": 15 } } },
        "tags": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 30 } }
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false, "required": ["status", "passing_count", "source_coverage", "warnings"],
      "properties": {
        "status": { "enum": ["passed", "degraded", "failed"] },
        "passing_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "source_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "gate": { "enum": ["passed", "degraded", "failed"] },
        "primary_source_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
