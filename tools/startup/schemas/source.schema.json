{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanwan-ai.github.io/schema/startup-source.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "url", "publisher", "published_at", "retrieved_at", "tier"],
  "properties": {
    "id": { "type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]{1,78}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 300 },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "publisher": { "type": "string", "minLength": 2, "maxLength": 120 },
    "published_at": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "tier": { "enum": ["primary", "reputable_secondary", "discovery_only"] },
    "snippet": { "type": "string", "maxLength": 1000 }
  }
}
