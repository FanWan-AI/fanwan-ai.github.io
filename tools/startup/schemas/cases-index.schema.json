{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanwan-ai.github.io/schema/startup-cases-index.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "updated_at", "cases"],
  "properties": {
    "schema_version": { "const": 1 }, "kind": { "const": "startup_case_index" }, "updated_at": { "type": "string", "format": "date-time" },
    "cases": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["slug", "published_at", "title", "company", "story_type", "dek", "verdict", "read_minutes", "case_path", "cover_theme"], "properties": { "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" }, "published_at": { "type": "string", "format": "date-time" }, "title": { "type": "string", "minLength": 5, "maxLength": 180 }, "company": { "type": "string", "minLength": 1, "maxLength": 120 }, "story_type": { "enum": ["growth", "pivotal_decision", "failure", "business_model", "technical_commercialization", "comparison"] }, "dek": { "type": "string", "minLength": 10, "maxLength": 500 }, "verdict": { "type": "string", "minLength": 20, "maxLength": 500 }, "read_minutes": { "type": "integer", "minimum": 1, "maximum": 60 }, "case_path": { "type": "string", "pattern": "^cases/[a-z0-9][a-z0-9-]{2,79}\\.json$" }, "cover_theme": { "type": "string", "minLength": 2, "maxLength": 40 } } } } }
}
