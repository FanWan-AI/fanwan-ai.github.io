{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanwan-ai.github.io/schema/startup-case-detail.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "slug", "status", "story_type", "company", "central_question", "title", "dek", "verdict", "timeline", "sections", "unknowns", "copy", "avoid", "next_experiment", "sources"],
  "properties": {
    "schema_version": { "const": 1 }, "kind": { "const": "startup_case_analysis" }, "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" }, "status": { "enum": ["draft", "published"] }, "story_type": { "enum": ["growth", "pivotal_decision", "failure", "business_model", "technical_commercialization", "comparison"] }, "company": { "type": "string", "minLength": 1, "maxLength": 120 }, "central_question": { "type": "string", "minLength": 20, "maxLength": 500 }, "title": { "type": "string", "minLength": 5, "maxLength": 180 }, "dek": { "type": "string", "minLength": 10, "maxLength": 700 }, "verdict": { "type": "string", "minLength": 20, "maxLength": 700 }, "pipeline_version": { "type": "string" },
    "published_at": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" }
      ]
    }, "updated_at": { "type": "string", "format": "date-time" }, "revision_note": { "type": "string", "maxLength": 500 }, "read_minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "timeline": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["date", "event", "source_ids"], "properties": { "date": { "type": "string", "minLength": 4, "maxLength": 30 }, "event": { "type": "string", "minLength": 8, "maxLength": 500 }, "source_ids": { "type": "array", "items": { "type": "string" } } } } },
    "sections": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "heading", "thesis", "paragraphs", "source_ids", "evidence_labels"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" }, "heading": { "type": "string", "minLength": 3, "maxLength": 160 }, "thesis": { "type": "string", "minLength": 15, "maxLength": 500 }, "paragraphs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 20, "maxLength": 1800 } }, "source_ids": { "type": "array", "items": { "type": "string" } }, "claim_types": { "type": "array", "uniqueItems": true, "items": { "enum": ["fact", "company_claim", "inference", "editorial_inference", "unknown"] } }, "evidence_labels": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["label", "text", "source_ids", "confidence"], "properties": { "label": { "enum": ["fact", "company_claim", "editorial_inference", "unknown"] }, "text": { "type": "string", "minLength": 8, "maxLength": 700 }, "source_ids": { "type": "array", "items": { "type": "string" } }, "confidence": { "enum": ["high", "medium", "low"] } } } } } } },
    "unknowns": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 8, "maxLength": 500 } }, "copy": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 8, "maxLength": 500 } }, "avoid": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 8, "maxLength": 500 } }, "next_experiment": { "type": "string", "minLength": 20, "maxLength": 700 }, "sources": { "type": "array", "items": { "$ref": "https://fanwan-ai.github.io/schema/startup-source.json" } },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "source_coverage", "verified_at", "warnings"],
      "properties": {
        "gate": { "enum": ["passed", "degraded", "failed"] },
        "source_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    }
  }
}
