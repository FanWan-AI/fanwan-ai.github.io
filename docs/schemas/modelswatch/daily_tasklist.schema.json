{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Daily Tasklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "date",
    "generated_at",
    "items",
    "stats"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/taskItem" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "unqualified": { "type": "integer", "minimum": 0 },
        "qualified": { "type": "integer", "minimum": 0 },
        "passonce": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "taskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "promptHash",
        "source",
        "priority",
        "reason"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source": { "type": "string", "enum": ["github", "huggingface"] },
        "priority": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
