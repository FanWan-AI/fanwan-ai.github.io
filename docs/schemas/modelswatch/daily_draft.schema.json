{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Daily Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "date",
    "source",
    "generated_at",
    "items",
    "stats"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "enum": ["github", "huggingface"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "stats": {
      "type": "object",
      "required": ["total", "qualified", "pending", "unqualified"],
      "additionalProperties": true,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "qualified": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "unqualified": { "type": "integer", "minimum": 0 },
        "fast_first": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/draftItem" }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "draftItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "promptHash",
        "summary_version",
        "status",
        "name",
        "url",
        "summary_short"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "origin_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": {
          "type": "string",
          "enum": ["github", "huggingface"]
        },
        "owner": { "type": "string" },
        "repo_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "summary_version": { "type": "integer", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["draft", "passonce", "unqualified", "pending", "qualified", "published"]
        },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary_short": { "$ref": "#/definitions/summaryShort" },
        "summary_flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "needs_tri": { "type": "boolean" },
            "fast_first": { "type": "boolean" },
            "placeholder": { "type": "boolean" }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
