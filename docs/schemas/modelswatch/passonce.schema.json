{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Passonce Collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "date",
    "source",
    "generated_at",
    "items",
    "stats"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "enum": ["github", "huggingface"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/passonceItem" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "from_fast_first": { "type": "integer", "minimum": 0 },
        "from_cache": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "passonceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "promptHash",
        "summary_version",
        "status",
        "summary_short",
        "name",
        "url"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "summary_version": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "const": "passonce" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary_short": { "$ref": "#/definitions/summaryShort" },
        "summary_flags": {
          "type": "object",
          "additionalProperties": true
        },
        "stats": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "locale_pref": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
