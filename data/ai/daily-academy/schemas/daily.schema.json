{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fanwan-ai.github.io/schemas/academy-daily.schema.json",
  "title": "AI Daily Academy Lessons",
  "type": "object",
  "required": ["generatedAt", "lessons"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lessons": {
      "type": "array",
      "items": { "$ref": "#/definitions/lesson" },
      "maxItems": 90
    }
  },
  "additionalProperties": false,
  "definitions": {
    "i18nStr": {
      "type": "object",
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "required": ["id", "date", "title", "summary", "content", "practice"],
      "properties": {
        "id": { "type": "string", "minLength": 4 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "$ref": "#/definitions/i18nStr" },
        "summary": { "$ref": "#/definitions/i18nStr" },
        "content": { "$ref": "#/definitions/i18nStr" },
        "difficulty": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10
        },
        "practice": {
          "type": "array",
          "items": { "$ref": "#/definitions/practiceEntry" },
          "minItems": 1,
          "maxItems": 5
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/definitions/reference" },
          "maxItems": 6
        },
        "audio": {
          "type": "object",
          "properties": {
            "zh": { "type": "string" },
            "en": { "type": "string" },
            "es": { "type": "string" }
          },
          "additionalProperties": false
        },
        "meta": {
          "type": "object",
          "properties": {
            "category": { "type": "string" },
            "level": { "type": "string" },
            "difficultyScore": { "type": "number" },
            "related": {
              "type": "array",
              "items": { "type": "string" }
            },
            "learningObjectives": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 8
            },
            "personas": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 8
            },
            "contextual_notes": { "$ref": "#/definitions/contextualNotes" },
            "tone_profile": { "$ref": "#/definitions/toneProfile" },
            "learner_profile": { "$ref": "#/definitions/learnerProfile" },
            "prompt_version": { "type": "string" },
            "starter_questions": {
              "type": "array",
              "items": { "$ref": "#/definitions/starterQuestion" },
              "maxItems": 3
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "practiceEntry": {
      "type": "object",
      "required": ["type", "question", "answer"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mcq", "multi", "input"]
        },
        "question": { "$ref": "#/definitions/i18nStr" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 6
        },
        "answer": {
          "anyOf": [
            { "type": "integer" },
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 1,
              "maxItems": 6
            }
          ]
        },
        "explain": { "$ref": "#/definitions/i18nStr" }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/definitions/i18nStr" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "contextualNotes": {
      "type": "object",
      "properties": {
        "why_now": { "type": "string" },
        "best_for": { "type": "string" },
        "visual_hint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "toneProfile": {
      "type": "object",
      "properties": {
        "persona": { "type": "string" },
        "style": { "type": "string" },
        "energy": { "type": "string" },
        "call_to_action": { "type": "string" }
      },
      "additionalProperties": false
    },
    "learnerProfile": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "prefersEnglish": { "type": "boolean" },
        "industries": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 6
        },
        "personas": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 6
        },
        "pains": { "type": "string" },
        "preferredMetrics": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 6
        },
        "maturity": { "type": "string" }
      },
      "additionalProperties": false
    },
    "starterQuestion": {
      "type": "object",
      "required": ["lang", "question"],
      "properties": {
        "lang": { "type": "string" },
        "question": { "type": "string" },
        "action_hint": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
