{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fanwan-ai.github.io/schemas/finance-daily.schema.json",
  "title": "Finance Daily Array",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "date",
      "topic",
      "summary",
      "key_points",
      "practice"
    ],
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "topic_id": {
        "type": "string"
      },
      "topic": {
        "$ref": "#/definitions/i18nStr"
      },
      "summary": {
        "$ref": "#/definitions/i18nStr"
      },
      "markdown_content": {
        "$ref": "#/definitions/i18nStr"
      },
      "key_points": {
        "type": "object",
        "properties": {
          "zh": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 6
          },
          "en": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          },
          "es": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          }
        },
        "additionalProperties": false
      },
      "practice": {
        "type": "object",
        "properties": {
          "zh": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "$ref": "#/definitions/practiceItem" } }
            ]
          },
          "en": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "$ref": "#/definitions/practiceItem" } }
            ]
          },
          "es": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "$ref": "#/definitions/practiceItem" } }
            ]
          }
        }
      },
      "risk_notes": {
        "$ref": "#/definitions/i18nStr"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 0,
        "maxItems": 6
      },
      "degraded": {
        "type": "boolean"
      },
      "meta": {
        "type": "object",
        "properties": {
          "lesson_id": { "type": "string" },
          "module_id": { "type": "string" },
          "category": {
            "type": "string"
          },
          "difficulty": {
            "type": [
              "integer",
              "number"
            ]
          },
          "level": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hash": {
            "type": "string",
            "minLength": 1
          },
          "degradedFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          },
          "learning_path": {
            "type": "string"
          },
          "difficulty_label": {
            "type": "string"
          },
          "practice": {
            "$ref": "#/definitions/practiceI18n"
          },
          "practice_preview": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/sourceEntry"
            },
            "maxItems": 6
          },
          "risk_notes": {
            "$ref": "#/definitions/i18nStr"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "definitions": {
    "i18nStr": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "required": [
        "zh"
      ],
      "additionalProperties": false
    },
    "practiceActivity": {
      "type": "object",
      "required": [
        "title",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 6
        }
      },
      "additionalProperties": false
    },
    "practiceItem": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "steps"]
    },
    "practiceI18n": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/practiceActivity"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "en": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/practiceActivity"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "es": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/practiceActivity"
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "sourceEntry": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/i18nStr"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
