{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fanwan-ai.github.io/schemas/topics.schema.json",
  "title": "Wealth Topics",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "level",
      "categories"
    ],
    "properties": {
      "level": {
        "type": "string",
        "minLength": 1
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "category",
            "topics"
          ],
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "difficulty": {
              "type": [
                "integer",
                "number"
              ]
            },
            "recommended_order": {
              "type": "integer"
            },
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "topic",
                  "difficulty",
                  "order"
                ],
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1
                  },
                  "difficulty": {
                    "type": "integer"
                  },
                  "order": {
                    "type": "integer"
                  },
                  "related_topics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  }
}
