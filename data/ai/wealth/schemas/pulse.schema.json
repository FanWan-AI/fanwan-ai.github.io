
{
		"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://fanwan-ai.github.io/schemas/pulse.schema.json",
	"title": "Wealth Market Pulse",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["date", "items"],
		"properties": {
			"date": {
				"type": "string",
				"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
			},
			"items": {
				"type": "array",
				"minItems": 2,
				"items": { "$ref": "#/$defs/PulseItem" },
						"allOf": [
							{
								"contains": {
									"type": "object",
									"properties": { "category": { "const": "global" } },
									"required": ["category"]
								}
							},
							{
								"contains": {
									"type": "object",
									"properties": { "category": { "const": "china" } },
									"required": ["category"]
								}
							}
						]
			}
		}
	},
	"$defs": {
		"I18nString": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"zh": { "type": "string", "minLength": 1 },
				"en": { "type": "string", "minLength": 1 },
				"es": { "type": "string", "minLength": 1 }
			}
		},
		"PulseItem": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"title",
				"source",
				"time_utc",
				"facts",
				"impact_one_liner",
				"links",
				"category"
			],
			"properties": {
				"title": { "type": "string", "minLength": 1 },
				"source": { "type": "string", "minLength": 1 },
				"time_utc": { "type": "string", "format": "date-time" },
				"facts": { "$ref": "#/$defs/I18nString" },
				"impact_one_liner": { "$ref": "#/$defs/I18nString" },
				"links": {
					"type": "array",
					"items": { "type": "string", "format": "uri" },
					"maxItems": 6
				},
				"category": { "type": "string", "enum": ["global", "china"] },
				"degraded": { "type": "boolean" }
			}
		}
	}
}
