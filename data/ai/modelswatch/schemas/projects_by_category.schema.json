{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Projects by Category Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "taxonomy",
    "updated_at",
    "categories"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "taxonomy": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "stats": {
      "type": "object",
      "additionalProperties": true
    },
    "categories": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/categoryBucket" }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "categoryLabel": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "indexItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "name", "url", "summary_short"],
      "properties": {
        "canonical_id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "summary_short": { "$ref": "#/definitions/summaryShort" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stats": {
          "type": "object",
          "additionalProperties": true
        },
        "source": { "type": "string" },
        "score": { "type": "number" }
      }
    },
    "categoryBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "count", "items"],
      "properties": {
        "label": { "$ref": "#/definitions/categoryLabel" },
        "count": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/indexItem" }
        }
      }
    }
  }
}