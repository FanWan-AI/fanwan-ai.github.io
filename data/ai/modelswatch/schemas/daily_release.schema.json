{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Daily Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "date",
    "source",
    "generated_at",
    "items",
    "stats"
  ],
  "properties": {
  "schema_version": { "type": "integer", "minimum": 1 },
  "version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "enum": ["github", "huggingface"] },
  "generated_at": { "type": "string", "format": "date-time" },
  "updated_at": { "type": "string", "format": "date-time" },
  "published_at": { "type": "string", "format": "date-time" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "qualified", "passonce"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "qualified": { "type": "integer", "minimum": 0 },
        "passonce": { "type": "integer", "minimum": 0 },
        "coverage_pct": { "type": "number", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "source_total": { "type": "integer", "minimum": 0 },
        "dropped_corpus": { "type": "integer", "minimum": 0 },
        "dropped_hotlist": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/releaseItem" }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "summaryLocales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "releaseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "promptHash",
        "summary_version",
        "status",
        "name",
        "url",
        "summary_short",
        "source"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "summary_version": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["qualified", "passonce"] },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "source": { "type": "string", "enum": ["github", "huggingface"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary_short": { "$ref": "#/definitions/summaryShort" },
        "summaries": { "$ref": "#/definitions/summaryLocales" },
        "locales": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provider": {
          "type": "object",
          "additionalProperties": true
        },
        "quality": {
          "type": "object",
          "additionalProperties": true
        },
        "stats": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "summary_flags": {
          "type": "object",
          "additionalProperties": true
        },
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project_categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "first_seen": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
