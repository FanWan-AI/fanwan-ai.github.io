{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fetch Priorities",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_version",
    "generated_at",
    "category_target",
    "task_target",
    "deficit_categories",
    "deficit_tasks",
    "source_recommendations",
    "taxonomy_refs",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 0 },
    "pipeline_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "category_target": { "type": "integer", "minimum": 0 },
    "task_target": { "type": "integer", "minimum": 0 },
    "deficit_categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/categoryEntry" }
    },
    "deficit_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskEntry" }
    },
    "source_recommendations": {
      "type": "object",
      "required": ["github", "huggingface"],
      "properties": {
        "github": {
          "type": "object",
          "required": ["focus_categories", "suggested_actions"],
          "properties": {
            "focus_categories": {
              "type": "array",
              "items": { "$ref": "#/$defs/categoryEntry" }
            },
            "suggested_actions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "huggingface": {
          "type": "object",
          "required": ["focus_tasks", "suggested_actions"],
          "properties": {
            "focus_tasks": {
              "type": "array",
              "items": { "$ref": "#/$defs/taskEntry" }
            },
            "suggested_actions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "taxonomy_refs": {
      "type": "object",
      "required": ["tasks", "categories"],
      "properties": {
        "tasks": { "type": "string" },
        "categories": { "type": "string" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "topExample": {
      "type": "object",
      "required": ["canonical_id"],
      "additionalProperties": false,
      "properties": {
        "canonical_id": { "type": "string" },
        "name": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "score": { "type": "number" }
      }
    },
    "sourceBreakdown": {
      "type": "object",
      "required": ["github", "huggingface"],
      "properties": {
        "github": { "$ref": "#/$defs/sourceStage" },
        "huggingface": { "$ref": "#/$defs/sourceStage" }
      }
    },
    "sourceStage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualified": { "type": "integer", "minimum": 0 },
        "passonce": { "type": "integer", "minimum": 0 },
        "backlog": { "type": "integer", "minimum": 0 }
      },
      "required": ["qualified", "passonce", "backlog"]
    },
    "categoryEntry": {
      "type": "object",
      "required": [
        "key",
        "label",
        "qualified",
        "passonce",
        "backlog",
        "deficit",
        "coverage_ratio",
        "top_examples"
      ],
      "properties": {
        "key": { "type": "string" },
        "label": { "$ref": "#/$defs/label" },
        "qualified": { "type": "integer", "minimum": 0 },
        "passonce": { "type": "integer", "minimum": 0 },
        "backlog": { "type": "integer", "minimum": 0 },
        "deficit": { "type": "integer", "minimum": 0 },
        "coverage_ratio": { "type": "number", "minimum": 0 },
        "top_examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/topExample" }
        }
      }
    },
    "taskEntry": {
      "type": "object",
      "required": [
        "key",
        "label",
        "qualified",
        "passonce",
        "backlog",
        "deficit",
        "coverage_ratio",
        "source_breakdown"
      ],
      "properties": {
        "key": { "type": "string" },
        "label": { "$ref": "#/$defs/label" },
        "qualified": { "type": "integer", "minimum": 0 },
        "passonce": { "type": "integer", "minimum": 0 },
        "backlog": { "type": "integer", "minimum": 0 },
        "deficit": { "type": "integer", "minimum": 0 },
        "coverage_ratio": { "type": "number", "minimum": 0 },
        "source_breakdown": { "$ref": "#/$defs/sourceBreakdown" },
        "top_examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/topExample" }
        }
      }
    }
  }
}
