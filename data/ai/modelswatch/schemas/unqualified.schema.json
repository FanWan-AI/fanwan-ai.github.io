{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Unqualified Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "date",
    "source",
    "generated_at",
    "items"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "enum": ["github", "huggingface"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/unqualifiedItem" }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "unqualifiedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "promptHash",
        "summary_version",
        "status",
        "summary_short"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "summary_version": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["pending", "unqualified"] },
        "summary_short": { "$ref": "#/definitions/summaryShort" },
        "tri_context": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
