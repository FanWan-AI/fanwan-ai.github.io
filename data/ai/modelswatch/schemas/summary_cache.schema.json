{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Summary Cache",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "generated_at",
    "models"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string" },
    "stats": { "type": "object", "additionalProperties": true },
    "models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/modelEntry" }
    }
  },
  "definitions": {
    "summaryLocales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary_version", "promptHash", "updated_at"],
      "properties": {
        "summary_version": { "type": "integer", "minimum": 1 },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "updated_at": { "type": "string", "format": "date-time" },
        "summaries": { "$ref": "#/definitions/summaryLocales" },
        "provider": { "type": "object", "additionalProperties": true },
        "quality": { "type": "object", "additionalProperties": true }
      }
    },
    "modelEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "canonical_id",
        "promptHash",
        "summary_version",
        "updated_at"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "summary_version": { "type": "integer", "minimum": 1 },
        "locales": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "summaries": { "$ref": "#/definitions/summaryLocales" },
        "summary_short": { "$ref": "#/definitions/summaryLocales" },
        "summary_en": { "type": "string" },
        "summary_zh": { "type": "string" },
        "summary_es": { "type": "string" },
        "summary": { "type": "string" },
        "provider": { "type": "object", "additionalProperties": true },
        "quality": { "type": "object", "additionalProperties": true },
        "history": {
          "type": "array",
          "items": { "$ref": "#/definitions/historyEntry" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "first_generated_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "fallback": { "type": "boolean" }
      }
    }
  }
}
