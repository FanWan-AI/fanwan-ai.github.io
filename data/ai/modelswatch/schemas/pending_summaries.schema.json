{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Pending Summaries Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "date",
    "generated_at",
    "items"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/pendingItem" }
    },
    "stats": {
      "type": "object",
      "required": ["total"],
      "additionalProperties": true,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 },
        "existing": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "pendingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "promptHash",
        "locales",
        "priority"
      ],
      "properties": {
        "canonical_id": { "type": "string" },
        "promptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "priority": { "type": "integer", "minimum": 0 },
        "requested_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["github", "huggingface"] },
        "reason": { "type": "string" }
      }
    }
  }
}
