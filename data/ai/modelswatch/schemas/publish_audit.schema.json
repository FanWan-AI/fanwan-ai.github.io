{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Publish Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "date",
    "generated_at",
    "run_id",
    "sources",
    "totals",
    "classification",
    "checksums"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["published", "qualified", "passonce", "coverage_pct"],
        "properties": {
          "published": { "type": "integer", "minimum": 0 },
          "qualified": { "type": "integer", "minimum": 0 },
          "passonce": { "type": "integer", "minimum": 0 },
          "coverage_pct": { "type": "number", "minimum": 0 },
          "duplicates": { "type": "integer", "minimum": 0 },
          "inputs": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "coverage_pct"],
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "coverage_pct": { "type": "number", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": { "$ref": "#/definitions/classificationStats" },
        "categories": { "$ref": "#/definitions/classificationStats" }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "classificationStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomy_total",
        "buckets_covered",
        "coverage_pct",
        "items_with_assignments",
        "items_without_assignments"
      ],
      "properties": {
        "taxonomy_total": { "type": "integer", "minimum": 0 },
        "buckets_covered": { "type": "integer", "minimum": 0 },
        "coverage_pct": { "type": "number", "minimum": 0 },
        "assignments": { "type": "integer", "minimum": 0 },
        "items_with_assignments": { "type": "integer", "minimum": 0 },
        "items_without_assignments": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
