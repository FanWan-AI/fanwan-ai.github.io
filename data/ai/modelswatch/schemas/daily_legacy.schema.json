{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Legacy Daily Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "version",
    "date",
    "generated_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/legacyItem" }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "legacyItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "canonical_id", "source", "status", "name", "url"],
      "properties": {
        "id": { "type": "string" },
        "canonical_id": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stats": {
          "type": "object",
          "additionalProperties": true
        },
        "summary": { "type": "string" },
        "summary_en": { "type": "string" },
        "summary_zh": { "type": "string" },
        "summary_es": { "type": "string" },
        "summary_short": { "$ref": "#/definitions/summaryShort" },
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project_categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "score": { "type": "number" },
        "score_model": { "type": "number" },
        "score_engineering": { "type": "number" },
        "score_task": { "type": "number" },
        "score_category": { "type": "number" },
        "reason_label": { "type": "string" },
        "reason_text": { "type": "string" },
        "first_seen": { "type": "string" },
        "last_seen": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    }
  }
}
