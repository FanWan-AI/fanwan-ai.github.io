{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Raw Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "generated_at",
    "source",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["github", "huggingface"]
    },
    "stats": {
      "type": "object",
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rawCorpusItem"
      }
    }
  },
  "definitions": {
    "summaryShort": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "es": { "type": "string" }
      }
    },
    "rawCorpusItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "source",
        "name",
        "url",
        "promptHash",
        "summary_version",
        "status",
        "summary_short"
      ],
      "properties": {
        "canonical_id": { "type": "string", "minLength": 3 },
        "origin_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "owner": { "type": "string" },
        "repo_id": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["github", "huggingface"]
        },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "passonce",
            "unqualified",
            "pending",
            "qualified",
            "published"
          ]
        },
        "summary_version": {
          "type": "integer",
          "minimum": 0
        },
        "promptHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "summary_short": {
          "$ref": "#/definitions/summaryShort"
        },
        "description": { "type": "string" },
        "summary_flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "needs_tri": { "type": "boolean" },
            "fast_first": { "type": "boolean" },
            "placeholder": { "type": "boolean" }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zh": { "type": "string" },
            "en": { "type": "string" },
            "es": { "type": "string" }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
