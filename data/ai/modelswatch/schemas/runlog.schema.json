{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Pipeline Runlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "date",
    "entries"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/runlogEntry" }
    }
  },
  "definitions": {
    "runlogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step",
        "status",
        "timestamp"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "step": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["started", "success", "warning", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" },
        "metrics": { "type": "object", "additionalProperties": true },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "additionalProperties": true,
            "properties": {
              "message": { "type": "string" },
              "stack": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
