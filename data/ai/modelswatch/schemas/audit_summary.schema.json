{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelSwatch Audit Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "generated_at",
    "run_id",
    "retention_days",
    "totals",
    "recent_publish",
    "recent_runlogs",
    "alerts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "retention_days": { "type": "integer", "minimum": 1 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runlog_files",
        "publish_audit_files",
        "other_files",
        "archived_files",
        "archived_bytes"
      ],
      "properties": {
        "runlog_files": { "type": "integer", "minimum": 0 },
        "publish_audit_files": { "type": "integer", "minimum": 0 },
        "other_files": { "type": "integer", "minimum": 0 },
        "archived_files": { "type": "integer", "minimum": 0 },
        "archived_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "recent_publish": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "totals",
          "sources",
          "hotlists"
        ],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "totals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items", "coverage_pct"],
            "properties": {
              "items": { "type": "integer", "minimum": 0 },
              "coverage_pct": { "type": "number", "minimum": 0 }
            }
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "published": { "type": "integer", "minimum": 0 },
                "qualified": { "type": "integer", "minimum": 0 },
                "coverage_pct": { "type": "number", "minimum": 0 }
              }
            }
          },
          "hotlists": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "models_categories": { "type": "integer", "minimum": 0 },
              "models_items": { "type": "integer", "minimum": 0 },
              "projects_categories": { "type": "integer", "minimum": 0 },
              "projects_items": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "recent_runlogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "total_entries", "steps"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "total_entries": { "type": "integer", "minimum": 0 },
          "steps": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "success": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "other": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "message"],
        "properties": {
          "level": { "type": "string", "enum": ["info", "warning", "critical"] },
          "message": { "type": "string" },
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
