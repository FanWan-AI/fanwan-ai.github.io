{"schema_version":1,"pipeline_version":"v6","run_id":"data-analysis-2026-09-01-20260901030125.-920d10d0","generated_at":"2026-09-01T03:01:25.490Z","canonical_id":"huggingface:BAAI/bge-small-en-v1.5","promptHash":"sha256:5ed6cb6fb5aa934e43677a957100253b7a8572eaddddcf9750de5c99dd45f1f3","summary_version":1,"status":"qualified","source":"huggingface","name":"bge-small-en-v1.5","url":"https://huggingface.co/BAAI/bge-small-en-v1.5","tags":["sentence-transformers","pytorch","onnx","safetensors","bert","feature-extraction","sentence-similarity","transformers","mteb","en","arxiv:2401.03462","arxiv:2312.15503","arxiv:2311.13534","arxiv:2310.07554","arxiv:2309.07597","license:mit","model-index","text-embeddings-inference","endpoints_compatible","deploy:sagemaker","deploy:azure","region:us"],"stats":{"downloads_total":67926190,"likes_total":540},"metadata":{"license":"N/A","lang":"N/A","categories":{"capabilities":[],"scenes":[],"lifecycle":[]}},"summary_short":{"zh":"BGE-small-en-v1.5 是一个高效的英文句子嵌入模型，能够将文本转换为语义丰富的向量表示，专门解决文档相似度计算和语义搜索问题。它通过对比学习结合困难负样本挖掘，并采用知识蒸馏技术从大模型中学习，在保持轻量级的同时实现了优异的性能表现。开发者可将其用于构建智能检索系统、文档聚类分析，或作为RAG架构中的编码器，特别适合部署在计算资源有限的环境中探索语义理解应用。","en":"BGE-small-en-v1.5 is a compact English sentence embedding model that converts text into meaningful numerical representations for semantic similarity tasks. It employs contrastive learning with hard negatives and knowledge distillation from larger models, achieving strong perform…","es":"BGE-small-en-v1.5 is a compact English sentence embedding model that converts text into meaningful numerical representations for semantic similarity tasks. It employs contrastive learning with hard negatives and knowledge distillation from larger models, achieving strong perform…"},"summaries":{"en":"BGE-small-en-v1.5 is a compact English sentence embedding model that converts text into meaningful numerical representations for semantic similarity tasks. It employs contrastive learning with hard negatives and knowledge distillation from larger models, achieving strong performance despite its small size. You can use it for semantic search, clustering similar documents, or as a lightweight encoder in retrieval-augmented generation pipelines, making it ideal for resource-constrained applications.","zh":"BGE-small-en-v1.5 是一个高效的英文句子嵌入模型，能够将文本转换为语义丰富的向量表示，专门解决文档相似度计算和语义搜索问题。它通过对比学习结合困难负样本挖掘，并采用知识蒸馏技术从大模型中学习，在保持轻量级的同时实现了优异的性能表现。开发者可将其用于构建智能检索系统、文档聚类分析，或作为RAG架构中的编码器，特别适合部署在计算资源有限的环境中探索语义理解应用。","es":"BGE-small-en-v1.5 is a compact English sentence embedding model that converts text into meaningful numerical representations for semantic similarity tasks. It employs contrastive learning with hard negatives and knowledge distillation from larger models, achieving strong performance despite its small size. You can use it for semantic search, clustering similar documents, or as a lightweight encoder in retrieval-augmented generation pipelines, making it ideal for resource-constrained applications."},"provider":{"name":"deepseek-tri","version":"1.0.0","mode":"json_single"},"quality":{"score":0.92,"fallback":false,"length":{"en":501,"zh":188,"es":501},"warnings":["es_short:0"],"accepted_at":"2025-10-11T07:00:49.059Z"}}
