name: Model Watch daily

on:
  schedule:
    # Daily 06:00 Beijing = Daily 22:00 UTC (previous day)
    - cron: '0 22 * * *'
  workflow_dispatch:

jobs:
  run:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Daily picks
        env:
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          DEEPSEEK_BASE_URL: ${{ secrets.DEEPSEEK_BASE_URL }}
          DEEPSEEK_MODEL: deepseek-v4-flash
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          # Tri/bi-lingual summarizer and caching toggles
          BILINGUAL_MODE: 1
          # Daily should not inherit the weekly global batch flag by default.
          # Use repository variable SNAPSHOT_USE_BATCH_DAILY to control daily batch behavior; default to '0' (no batch).
          SNAPSHOT_USE_BATCH: ${{ vars.SNAPSHOT_USE_BATCH_DAILY || '0' }}
          # Prefer picks that have bilingual summaries (zh+en) produced by weekly snapshots
          MODELSWATCH_DAILY_REQUIRE_BILINGUAL: ${{ vars.MODELSWATCH_DAILY_REQUIRE_BILINGUAL || '1' }}
          TRI_CACHE_FILE: data/ai/modelswatch/tri_cache.json
          TRI_CACHE_PERSIST: 1
          # Conservative batching defaults for daily runs
          TRI_GROUP_JSON_SIZE: '2'
          TRI_BATCH_CONCURRENCY: 2
          # Cap number of NEW LLM summaries per run to limit cold-start cost
          SNAPSHOT_MAX_NEW: 40
          SNAPSHOT_MIN_PER_SOURCE: 3
          # Kill long-running batch summarizer after N seconds
          SNAPSHOT_BATCH_KILL_TIMEOUT: ${{ vars.SNAPSHOT_BATCH_KILL_TIMEOUT || '600' }}
          # Tunable fetch limits (set these as repository Variables to adjust without code changes)
          MODELSWATCH_HF_LIMIT: ${{ vars.MODELSWATCH_HF_LIMIT }}
          MODELSWATCH_GH_PER_PAGE: ${{ vars.MODELSWATCH_GH_PER_PAGE }}
          MODELSWATCH_DAILY_GH_N: ${{ vars.MODELSWATCH_DAILY_GH_N }}
          MODELSWATCH_DAILY_HF_N: ${{ vars.MODELSWATCH_DAILY_HF_N }}
          MODELSWATCH_DAILY_COOLDOWN_DAYS: ${{ vars.MODELSWATCH_DAILY_COOLDOWN_DAYS }}
          MODELSWATCH_DAILY_HISTORY_WINDOW: ${{ vars.MODELSWATCH_DAILY_HISTORY_WINDOW }}
          MODELSWATCH_DAILY_ALPHA: ${{ vars.MODELSWATCH_DAILY_ALPHA }}
        run: |
          node -v
          echo "[workflow] Node version above. ENV check:" 
          echo "[workflow][env] SNAPSHOT_USE_BATCH=${SNAPSHOT_USE_BATCH:-unset} SNAPSHOT_BATCH_KILL_TIMEOUT=${SNAPSHOT_BATCH_KILL_TIMEOUT:-unset} TRI_GROUP_JSON_SIZE=${TRI_GROUP_JSON_SIZE:-unset} TRI_BATCH_CONCURRENCY=${TRI_BATCH_CONCURRENCY:-unset} MODELSWATCH_HF_LIMIT=${MODELSWATCH_HF_LIMIT:-unset} MODELSWATCH_GH_PER_PAGE=${MODELSWATCH_GH_PER_PAGE:-unset}"
          echo "[workflow] Checking tokens: GITHUB_TOKEN/HF_TOKEN present? (no secrets printed)"
          if [ -z "${GITHUB_TOKEN}" ]; then echo "[workflow][warn] GITHUB_TOKEN not set"; fi
          if [ -z "${HF_TOKEN}" ]; then echo "[workflow][warn] HF_TOKEN not set"; fi
          # Skip building snapshots if weekly has already produced a recent snapshot.
          # Check data/ai/modelswatch/latest_snapshot.json -> compare 'latest' with today's date in Asia/Shanghai.
          LATEST_FILE=data/ai/modelswatch/latest_snapshot.json
          if [ -f "$LATEST_FILE" ] && [ "$(TZ=Asia/Shanghai date +%F)" = "$(jq -r .latest $LATEST_FILE 2>/dev/null)" ]; then
            echo "[workflow] latest snapshot present for today; skipping build_snapshots"
          else
            echo "[workflow] no latest snapshot for today -> building snapshots"
            node tools/modelswatch/build_snapshots.mjs || echo "snapshot build failed"
          fi
          # Incremental tri-lingual snapshot summaries (reuses cache)
          # If weekly already produced enriched snapshot sidecars for the latest snapshot, skip running the batch summarizer here.
          LATEST_FILE=data/ai/modelswatch/latest_snapshot.json
          if [ -f "$LATEST_FILE" ] && LATEST=$(jq -r .latest $LATEST_FILE 2>/dev/null) && [ -n "$LATEST" ] && [ -f "data/ai/modelswatch/snapshots/$LATEST/hf_summaries.json" ]; then
            echo "[workflow] enriched hf_summaries.json present for latest snapshot; checking quality of zh summaries"
            HS=\"data/ai/modelswatch/snapshots/$LATEST/hf_summaries.json\"
            total=$(jq '.items | length' "$HS" 2>/dev/null || echo 0)
            # count entries with a non-placeholder Chinese summary (length > 40 and not containing common placeholder markers)
            good=$(jq '[.items[] | select((.summary_zh|type=="string") and (.summary_zh|length > 40) and ( (.summary_zh|test("占位|占位符|Auto summary|batch-fallback|fallback|自动摘要" )|not ))] | length' "$HS" 2>/dev/null || echo 0)
            echo "[workflow] snapshot $LATEST total=$total good_zh=$good"
            pct=0
            if [ "$total" -gt 0 ]; then
              pct=$(( 100 * good / total ))
            fi
            echo "[workflow] zh_quality_pct=$pct%"
            # threshold: require at least 50% non-placeholder Chinese summaries, otherwise regenerate (force batch)
            if [ "$pct" -lt 50 ]; then
              echo "[workflow] zh coverage below threshold; forcing batch generation to produce bilingual summaries"
              SNAPSHOT_USE_BATCH=1 node tools/modelswatch/generate_snapshot_summaries.mjs || echo "snapshot summaries failed"
            else
              echo "[workflow] zh coverage sufficient; skipping generate_snapshot_summaries"
            fi
          else
            echo "[workflow] enriched snapshot not found -> generating summaries"
            node tools/modelswatch/generate_snapshot_summaries.mjs || echo "snapshot summaries failed"
          fi
          # Summary coverage JSON
          node tools/modelswatch/summaries_coverage.mjs || echo "summaries coverage failed"
          node tools/modelswatch/daily.mjs
      - name: Commit and push changes directly to main
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          # Check whether the target branch 'main' has branch protection enabled.
          # Best-effort using the GitHub REST API. If protected, exit with a clear message.
          echo "[workflow] Checking branch protection for 'main'..."
          PROT_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: token ${GITHUB_TOKEN}" -H "Accept: application/vnd.github.luke-cage-preview+json" "https://api.github.com/repos/${GITHUB_REPOSITORY}/branches/main/protection") || true
          if [ "$PROT_STATUS" = "200" ]; then
            echo "Branch 'main' appears to be protected (HTTP 200 from protection endpoint)."
            echo "This workflow is configured to push directly to 'main', but branch protection will block direct pushes."
            echo "Options: 1) disable protection for automation commits, 2) allow GITHUB_TOKEN to bypass (not possible), 3) allow PR-based flow."
            echo "Failing early to avoid confusing push errors. If you want me to fall back to creating a PR instead, tell me and I'll switch back."
            exit 1
          elif [ "$PROT_STATUS" = "404" ]; then
            echo "Branch protection not detected for 'main' (HTTP 404). Proceeding with commit/push."
          else
            echo "Could not determine branch protection status (HTTP $PROT_STATUS). Proceeding but push may fail if protection exists."
          fi
          # Stage generated artifacts
          git add data/ai/modelswatch/daily_*.json data/ai/modelswatch/daily/*.json data/ai/modelswatch/daily/dates.json data/ai/modelswatch/state.json || true
          git add data/ai/modelswatch/snapshots/** data/ai/modelswatch/summary_cache.json data/ai/modelswatch/summaries_coverage.json || true
          git add data/ai/modelswatch/tri_cache.json data/ai/modelswatch/summary_cache.json || true
          if git diff --cached --quiet; then
            echo "No changes to commit"
            exit 0
          fi
          git commit -m "chore(modelswatch): daily picks"
          # Ensure we have the latest remote main
          git fetch origin main || true
          # Try a rebase first (preserve linear history). If rebase fails, abort and try a merge fallback.
          if git rebase --autostash origin/main; then
            echo "Rebase succeeded; pushing to origin/main"
            git push origin HEAD:main
          else
            echo "Rebase failed; aborting rebase and attempting merge fallback"
            git rebase --abort || true
            if git merge --no-edit origin/main; then
              echo "Merge succeeded; pushing to origin/main"
              if ! git push origin HEAD:main; then
                echo "Push failed; attempting force-with-lease"
                git push --force-with-lease origin HEAD:main
              fi
            else
              echo "Merge also failed; leaving changes for manual resolution and failing the job"
              exit 1
            fi
          fi
