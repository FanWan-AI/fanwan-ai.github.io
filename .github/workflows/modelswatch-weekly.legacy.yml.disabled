name: Model Watch weekly

on:
  schedule:
    # Sunday 20:00 Beijing = Sunday 12:00 UTC
    - cron: '0 12 * * 0'
  workflow_dispatch:

jobs:
  run:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Weekly top updates
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          DEEPSEEK_BASE_URL: ${{ secrets.DEEPSEEK_BASE_URL }}
          DEEPSEEK_MODEL: deepseek-v4-flash
          LLM_CONN_TIMEOUT: ${{ secrets.LLM_CONN_TIMEOUT }}
          LLM_READ_TIMEOUT: ${{ secrets.LLM_READ_TIMEOUT }}
          HOTLIST_LIMIT_PER_TASK: 2
          HOTLIST_MIN_SEED_PER_TASK: 2
          HOTLIST_LIMIT_PER_CATEGORY: 2
          HOTLIST_MIN_SEED_PER_CATEGORY: 2
          HOTLIST_DEBUG: 1
          MODELSWATCH_DEBUG: 1
          SUMMARY_FALLBACK: 1
          USE_PYTHON_SUMMARIZER: 1
          TRI_ENABLE_REWRITE: ${{ vars.TRI_ENABLE_REWRITE || '1' }}
          TRI_ENABLE_EXPAND: ${{ vars.TRI_ENABLE_EXPAND || '1' }}
          TRI_BATCH_CONCURRENCY: ${{ vars.TRI_BATCH_CONCURRENCY || '2' }}
          TRI_GROUP_JSON_SIZE: ${{ vars.TRI_GROUP_JSON_SIZE || '1' }}
          TRI_CACHE_FILE: data/ai/modelswatch/tri_cache.json
          TRI_CACHE_PERSIST: 1
          # Ensure snapshot summaries are generated via the Python batch summarizer
          BILINGUAL_MODE: 1
          # Rate-limits for cold-start control: cap number of NEW LLM summaries per run
          SNAPSHOT_MAX_NEW: ${{ vars.SNAPSHOT_MAX_NEW || '80' }}
          SNAPSHOT_MIN_PER_SOURCE: 5
          # Kill long-running batch summarizer after N seconds (prevents runaway jobs)
          # Prefer to configure this via GitHub Repository Variables: set variable 'SNAPSHOT_BATCH_KILL_TIMEOUT'
          # Fallback to 900 seconds if the variable is not set
          SNAPSHOT_BATCH_KILL_TIMEOUT: ${{ vars.SNAPSHOT_BATCH_KILL_TIMEOUT || '1800' }}
          # Tunable fetch limits (set these as repository Variables to adjust without code changes)
          MODELSWATCH_HF_LIMIT: ${{ vars.MODELSWATCH_HF_LIMIT }}
          MODELSWATCH_GH_PER_PAGE: ${{ vars.MODELSWATCH_GH_PER_PAGE }}
          # New performance toggles
          # Force weekly snapshot generation to use batch (bilingual summaries produced in batch)
          # Prefer a weekly-specific repository variable; fall back to global SNAPSHOT_USE_BATCH, then default to '1'
          SNAPSHOT_USE_BATCH: ${{ vars.SNAPSHOT_USE_BATCH_WEEKLY || vars.SNAPSHOT_USE_BATCH || '1' }}         # use single python batch call for snapshot summaries (default ON for weekly)
          SPEED_MODE: ${{ vars.SPEED_MODE || '1' }}                # disable rewrite/expand for speed
          UNIFIED_JSON_NO_SEQ: 1        # if JSON-first returns partial, skip sequential fallback
          SKIP_TOP_ENRICH: 1            # skip per-item enrichment in weekly top lists (avoid duplicate summarization)
          BATCH_PROGRESS_INTERVAL: 10   # every 10 items print progress to stderr during batch
          RESET_MODELWATCH_ALL: ${{ vars.RESET_MODELWATCH_ALL }}
          RESET_MODELWATCH_CONFIRM: 1
          # (Optional) Post-cold-start cost controls (uncomment to enable)
          # SNAPSHOT_MAX_NEW: 40                # cap number of NEW items per run needing LLM summaries
          # SNAPSHOT_MIN_PER_SOURCE: 5          # guarantee at least 5 from each source (hf/github) before cap
          # SNAPSHOT_PRIORITY_FIELDS: downloads_total,stars,likes_total  # ordering for priority mode
          # SNAPSHOT_LIMIT_MODE: priority       # or 'random'
        run: |
          node -v
          python -V
          echo "[workflow] Node/py versions above. ENV check:" 
          echo "[workflow][env] SNAPSHOT_USE_BATCH=${SNAPSHOT_USE_BATCH:-unset} SNAPSHOT_BATCH_KILL_TIMEOUT=${SNAPSHOT_BATCH_KILL_TIMEOUT:-unset} TRI_GROUP_JSON_SIZE=${TRI_GROUP_JSON_SIZE:-unset} TRI_BATCH_CONCURRENCY=${TRI_BATCH_CONCURRENCY:-unset} MODELSWATCH_HF_LIMIT=${MODELSWATCH_HF_LIMIT:-unset} MODELSWATCH_GH_PER_PAGE=${MODELSWATCH_GH_PER_PAGE:-unset}"
          echo "[workflow] Checking for GH/HF token availability (no secrets printed)"
          if [ -z "${GITHUB_TOKEN}" ]; then echo "[workflow][warn] GITHUB_TOKEN is not set (will use unauthenticated GitHub requests)"; fi
          if [ -z "${HF_TOKEN}" ]; then echo "[workflow][warn] HF_TOKEN is not set (HuggingFace requests may be limited)"; fi
          python -m pip install --upgrade pip >/dev/null 2>&1 || true
          python -m pip install requests >/dev/null 2>&1 || true
          if [ "${RESET_MODELWATCH_ALL}" = "1" ]; then
            echo "[workflow] RESET_MODELWATCH_ALL=1 -> purging historical ModelWatch artifacts"
            node tools/modelswatch/reset_modelswatch.mjs --yes || echo "reset script failed"
          else
            echo "[workflow] reset skipped (RESET_MODELWATCH_ALL != 1)"
          fi
          node tools/modelswatch/weekly.mjs
          # (generate_snapshot_summaries.mjs already invoked inside weekly.mjs after snapshots; skip duplicate call)
          # Coverage for tri-lingual summaries
          node tools/modelswatch/summaries_coverage.mjs || echo "summaries coverage failed"
          node tools/modelswatch/seed_hotlists.mjs
          # Coverage report (write JSON + console)
          node tools/modelswatch/analyze_hotlist_coverage.mjs --hotlist data/ai/modelswatch/models_hotlist.json --categories data/ai/ai_categories.json --out data/ai/modelswatch/coverage_summary.json || echo "coverage script failed"
          if [ ! -f data/ai/modelswatch/coverage_summary.json ]; then echo '{"note":"coverage summary not generated"}' > data/ai/modelswatch/coverage_summary.json; fi
          echo "--- coverage_summary.json ---" && cat data/ai/modelswatch/coverage_summary.json || true
          # Generate tri-lingual summaries (non-fatal on failure)
          node tools/modelswatch/generate_summaries.mjs || echo "summaries generation failed"
          echo "--- weekly_summaries.json (excerpt) ---" && head -c 800 data/ai/modelswatch/weekly_summaries.json || true
          # New: summary integrity + bucket coverage guards (warnings only)
          node tools/modelswatch/summary_integrity_check.mjs || echo "summary integrity check failed"
          node tools/modelswatch/coverage_guard.mjs || echo "coverage guard failed"
          node tools/modelswatch/classification_stats.mjs || echo "classification stats failed"
          # Build cross-date HF aggregation for frontend "all dates" search
          node tools/modelswatch/build_all_hf.mjs || echo "build_all_hf failed"
          # Asynchronous enrichment worker moved to a dedicated step (run only when pending present).
      - name: Commit and push
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          # Add all generated ModelWatch artefacts under data/ai/modelswatch; tolerant to missing files
          git add -A data/ai/modelswatch || true
          # Ensure tri cache and summary cache are staged for commit when present
          git add data/ai/modelswatch/tri_cache.json data/ai/modelswatch/summary_cache.json || true
          if git diff --cached --quiet; then
            echo "No changes to commit"
          else
            git commit -m "chore(modelswatch): weekly pipeline (tops+corpus+snapshots+hotlists)"
            # Fetch remote main and attempt a rebase to avoid push rejection when remote has moved on
            git fetch origin main || true
            if git show-ref --verify --quiet refs/remotes/origin/main; then
              echo "Attempting to rebase on origin/main (with autostash)"
              echo "[debug] git status before rebase:"; git status --porcelain || true
              echo "[debug] unstaged/diff files:"; git diff --name-only || true
              # Use --autostash to automatically stash local changes, rebase, then reapply stash
              if git rebase --autostash origin/main; then
                git push origin HEAD:main
              else
                echo "[warning] Rebase with autostash failed, aborting push to avoid conflicts"
                git rebase --abort || true
                # Output status for debugging in CI logs
                echo "[debug] git status after failed rebase:"; git status --porcelain || true
                echo "[debug] git diff after failed rebase:"; git --no-pager diff || true
              fi
            else
              # No remote ref found; push normally
              git push origin HEAD:main
            fi
          fi
      - name: Run async tri_worker (if pending)
        env:
          SNAPSHOT_BATCH_KILL_TIMEOUT: ${{ vars.SNAPSHOT_BATCH_KILL_TIMEOUT || '900' }}
          TRI_GROUP_JSON_SIZE: ${{ vars.TRI_GROUP_JSON_SIZE || '1' }}
          TRI_BATCH_CONCURRENCY: ${{ vars.TRI_BATCH_CONCURRENCY || '2' }}
          PROCESS_ALL_PENDING: ${{ vars.PROCESS_ALL_PENDING || '0' }}
          POST_REFRESH_SNAPSHOTS: ${{ vars.POST_REFRESH_SNAPSHOTS || '0' }}
          TRI_AUTO_COMMIT: ${{ vars.TRI_AUTO_COMMIT || '0' }}
          TRI_CACHE_FILE: data/ai/modelswatch/tri_cache.json
          TRI_CACHE_PERSIST: 1
        run: |
          echo "[workflow] Checking pending_summaries.json before running tri_worker"
          if [ -s data/ai/modelswatch/pending_summaries.json ]; then
            node -e "const fs=require('fs');const f='data/ai/modelswatch/pending_summaries.json';try{const a=JSON.parse(fs.readFileSync(f)); if(!Array.isArray(a)||a.length===0){console.log('[workflow] pending_summaries.json is empty; skipping tri_worker'); process.exit(0);} console.log('[workflow] pending count='+a.length);}catch(e){console.log('[workflow] pending_summaries.json parse error',e); process.exit(0);}"
            if [ $? -eq 0 ]; then
              echo "[workflow] Running async tri_worker to enrich pending summaries"
              node tools/modelswatch/tri_worker.mjs || echo "tri_worker failed"
            else
              echo "[workflow] Node check failed; skipping tri_worker"
            fi
          else
            echo "[workflow] pending_summaries.json not found or empty; skipping tri_worker"
          fi
      - name: Upload modelswatch diagnostics
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: modelswatch-diagnostics
          path: |
            data/ai/modelswatch/tri_worker_diagnostics.json
            data/ai/modelswatch/summaries_diagnostics.json
            data/ai/modelswatch/pending_summaries.json
            data/ai/modelswatch/tri_cache.json
            data/ai/modelswatch/summary_cache.json

  tri_worker:
    name: tri_worker (long-run)
    runs-on: ubuntu-latest
    needs: run
    timeout-minutes: 180
    if: ${{ always() }}
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Run tri_worker (only when pending present)
        env:
          SNAPSHOT_BATCH_KILL_TIMEOUT: ${{ vars.SNAPSHOT_BATCH_KILL_TIMEOUT || '3600' }}
          TRI_GROUP_JSON_SIZE: ${{ vars.TRI_GROUP_JSON_SIZE || '2' }}
          TRI_BATCH_CONCURRENCY: ${{ vars.TRI_BATCH_CONCURRENCY || '4' }}
          PROCESS_ALL_PENDING: ${{ vars.PROCESS_ALL_PENDING || '0' }}
          POST_REFRESH_SNAPSHOTS: ${{ vars.POST_REFRESH_SNAPSHOTS || '0' }}
          TRI_AUTO_COMMIT: ${{ vars.TRI_AUTO_COMMIT || '0' }}
          # Ensure tri_summarizer runtime honors repository variables for quality toggles
          SPEED_MODE: ${{ vars.SPEED_MODE || '1' }}
          TRI_ENABLE_REWRITE: ${{ vars.TRI_ENABLE_REWRITE || '1' }}
          TRI_ENABLE_EXPAND: ${{ vars.TRI_ENABLE_EXPAND || '1' }}
          BILINGUAL_MODE: ${{ vars.BILINGUAL_MODE || '1' }}
          # Provider tokens/keys required by tri_summarizer (sourced from repository secrets)
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          DEEPSEEK_BASE_URL: ${{ secrets.DEEPSEEK_BASE_URL }}
          DEEPSEEK_MODEL: deepseek-v4-flash
          LLM_CONN_TIMEOUT: ${{ secrets.LLM_CONN_TIMEOUT }}
          LLM_READ_TIMEOUT: ${{ secrets.LLM_READ_TIMEOUT }}
          TRI_CACHE_FILE: data/ai/modelswatch/tri_cache.json
          TRI_CACHE_PERSIST: 1
        run: |
          echo "[tri_worker job] checking pending_summaries.json"
          # Ensure Python dependencies required by tools/tri_summarizer.py are available
          python -m pip install --upgrade pip >/dev/null 2>&1 || true
          python -m pip install requests >/dev/null 2>&1 || true
          if [ -s data/ai/modelswatch/pending_summaries.json ]; then
            node -e "const fs=require('fs');const f='data/ai/modelswatch/pending_summaries.json';try{const a=JSON.parse(fs.readFileSync(f)); if(!Array.isArray(a)||a.length===0){console.log('[tri_worker job] pending is empty; skipping'); process.exit(0);} console.log('[tri_worker job] pending count='+a.length);}catch(e){console.log('[tri_worker job] parse error',e); process.exit(0);}"
            if [ $? -eq 0 ]; then
              echo "[tri_worker job] running tri_worker.mjs"
              node tools/modelswatch/tri_worker.mjs || echo "tri_worker job failed"
            else
              echo "[tri_worker job] node check failed; skipping"
            fi
          else
            echo "[tri_worker job] pending file not present or empty; skipping"
          fi
