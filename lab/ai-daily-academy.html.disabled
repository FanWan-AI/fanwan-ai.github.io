<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-i18n="academy_meta_title">AI 每日学堂 · AI Daily Academy</title>
  <link rel="icon" href="../assets/logo.svg" type="image/svg+xml">
  <meta name="theme-color" content="#4f46e5">
  <meta name="description" content="每天 10 分钟，构建你的 AI 核心知识体系。精选微课、练习与进度追踪，帮助你长期掌握 AI 能力。" data-i18n-content="academy_meta_desc">
  <link rel="canonical" href="https://fanwan-ai.github.io/lab/ai-daily-academy.html">
  <meta property="og:type" content="website">
  <meta property="og:title" content="AI 每日学堂 · AI Daily Academy" data-i18n-content="academy_meta_title">
  <meta property="og:description" content="每天 10 分钟，构建你的 AI 核心知识体系。精选微课、练习与进度追踪，帮助你长期掌握 AI 能力。" data-i18n-content="academy_meta_desc">
  <meta property="og:image" content="https://fanwan-ai.github.io/assets/og/ai-daily-academy-cover.jpg">
  <meta property="og:url" content="https://fanwan-ai.github.io/lab/ai-daily-academy.html">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="AI 每日学堂 · AI Daily Academy" data-i18n-content="academy_meta_title">
  <meta name="twitter:description" content="每天 10 分钟，构建你的 AI 核心知识体系。精选微课、练习与进度追踪，帮助你长期掌握 AI 能力。" data-i18n-content="academy_meta_desc">
  <meta name="twitter:image" content="https://fanwan-ai.github.io/assets/og/ai-daily-academy-cover.jpg">
  <script src="../lang-preload.js"></script>
  <script>
    (function(){
      try {
        var root = document.documentElement;
        if (!root) return;
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) { saved = null; }
        var hasManual = saved === 'light' || saved === 'dark';
        if (!hasManual && saved) {
          try { localStorage.removeItem('theme'); } catch (e2) {}
        }
        var prefersDark = false;
        try {
          prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch (e3) { prefersDark = false; }
        var theme = hasManual ? saved : (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);
        root.setAttribute('data-theme-mode', hasManual ? theme : ('system-' + theme));
        root.setAttribute('data-theme-source', hasManual ? 'user' : 'system');
      } catch(e){}
    })();
  </script>
  <style>
    html[data-lang-loading="true"] body { visibility: hidden; }
  </style>
  <link rel="stylesheet" href="../style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  <script defer src="../lang.js"></script>
  <script defer src="../script.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  <style>
    :root {
      --academy-bg: #f8fbff;
      --academy-panel: #ffffff;
      --academy-panel-border: rgba(15, 23, 42, 0.08);
      --academy-shadow: 0 20px 60px -40px rgba(15, 23, 42, 0.35);
      --academy-text: #0f172a;
      --academy-muted: #4c556e;
      --academy-accent: #2563eb;
      --academy-accent-soft: rgba(37, 99, 235, 0.1);
      --academy-cta: #0ea5e9;
      --academy-cta-dark: #0369a1;
      --academy-ghost: rgba(15, 23, 42, 0.06);
      --academy-ghost-border: rgba(15, 23, 42, 0.12);
    }

    :root[data-theme="dark"], :root[data-theme^="system-dark"] {
      --academy-bg: #020617;
      --academy-panel: rgba(2, 6, 23, 0.92);
      --academy-panel-border: rgba(148, 163, 184, 0.2);
      --academy-shadow: 0 30px 80px -50px rgba(0, 0, 0, 0.8);
      --academy-text: #f1f5f9;
      --academy-muted: #94a3b8;
      --academy-accent: #60a5fa;
      --academy-accent-soft: rgba(96, 165, 250, 0.15);
      --academy-ghost: rgba(148, 163, 184, 0.1);
      --academy-ghost-border: rgba(148, 163, 184, 0.3);
      --academy-cta: #38bdf8;
      --academy-cta-dark: #0c4a6e;
    }

    /* Code runner styling */
    .code-runner { border: 1px solid var(--academy-panel-border); border-radius: 16px; background: rgba(15, 23, 42, 0.015); overflow: hidden; box-shadow: 0 10px 28px -20px rgba(15, 23, 42, 0.35); }
    .code-runner__toolbar { display: flex; align-items: center; justify-content: flex-start; gap: 10px; padding: 10px 14px; background: var(--academy-ghost); border-bottom: 1px solid var(--academy-panel-border); }
    .code-runner__toolbar span { font-weight: 600; font-size: 0.9rem; color: var(--academy-text); }
    .code-runner__btn { border: 1px solid var(--academy-cta); background: var(--academy-cta); color: #fff; border-radius: 10px; padding: 8px 12px; cursor: pointer; font-weight: 600; font-size: 0.9rem; transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .code-runner__btn:hover { transform: translateY(-1px); box-shadow: 0 12px 30px -20px var(--academy-cta); }
    .code-runner__btn:disabled { opacity: 0.55; cursor: not-allowed; box-shadow: none; transform: none; }
    .code-runner__btn--ghost { background: transparent; border-color: var(--academy-panel-border); color: var(--academy-text); box-shadow: none; }
    .code-runner__btn--ghost:hover { box-shadow: none; transform: none; }
    .code-runner pre { margin: 0; padding: 14px; background: transparent; border: 0; border-radius: 0; overflow: auto; font-size: 0.92rem; line-height: 1.45; }
    .code-runner code { display: block; white-space: pre; color: var(--academy-text); }
    .code-runner__output { border-top: 1px dashed var(--academy-panel-border); background: rgba(15, 23, 42, 0.02); max-height: 260px; overflow: auto; color: var(--academy-text); }
    .code-runner__output[data-state="running"] { color: var(--academy-muted); }
    :root[data-theme="dark"] .code-runner { background: rgba(148, 163, 184, 0.04); }
    :root[data-theme="dark"] .code-runner__output { background: rgba(148, 163, 184, 0.08); }

    .page-hero.academy-hero {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(37, 99, 235, 0.75)),
        linear-gradient(45deg, rgba(14, 165, 233, 0.4), transparent 60%);
    }
    .page-hero.academy-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle at 15% 20%, rgba(14, 165, 233, 0.18), transparent 55%), radial-gradient(circle at 85% 30%, rgba(99, 102, 241, 0.25), transparent 55%);
      pointer-events: none;
      opacity: 0.5;
    }
    .page-hero.academy-hero .container { position: relative; z-index: 1; text-align: left; }
    .page-hero.academy-hero h1 { margin: 0 0 0.6rem; color: #fff; }
    .page-hero.academy-hero .subtitle { margin: 0; max-width: 56ch; color: rgba(248, 250, 252, 0.85); }

    .academy-console {
      background: var(--academy-bg);
      padding: clamp(64px, 8vw, 96px) 0;
    }
    .console-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
      gap: clamp(32px, 6vw, 64px);
      align-items: start;
    }
    @media (max-width: 980px) {
      .console-grid { grid-template-columns: 1fr; }
    }

    .console-copy {
      background: var(--academy-panel);
      border: 1px solid var(--academy-panel-border);
      border-radius: 32px;
      padding: clamp(28px, 5vw, 48px);
      box-shadow: var(--academy-shadow);
    }
    .console-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      border: 1px solid var(--academy-ghost-border);
      background: var(--academy-ghost);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .console-copy h2 { margin: 1rem 0 0.5rem; font-size: clamp(2rem, 4vw, 2.7rem); color: var(--academy-text); }
    .console-copy p { margin: 0 0 1.2rem; color: var(--academy-muted); line-height: 1.7; }
    .console-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 1rem; }
    .console-cta .btn {
      padding: 12px 24px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .console-cta .btn.primary { background: var(--academy-cta); color: #fff; box-shadow: 0 15px 40px -25px var(--academy-cta); }
    .console-cta .btn.primary:hover { transform: translateY(-1px); }
    .console-cta .btn.ghost { background: transparent; border-color: var(--academy-ghost-border); color: var(--academy-text); }

    .console-highlights { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 0.6rem; }
    .console-highlights li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--academy-muted); }
    .console-highlights li::before { content: "•"; color: var(--academy-accent); font-weight: 700; margin-top: -0.15rem; }

    .console-tools {
      background: var(--academy-panel);
      border: 1px solid var(--academy-panel-border);
      border-radius: 32px;
      padding: clamp(24px, 5vw, 40px);
      box-shadow: var(--academy-shadow);
      display: grid;
      gap: 20px;
    }
    .console-tools h3 { margin: 0; font-size: 1.3rem; color: var(--academy-text); }
    .console-tools p { margin: 0; color: var(--academy-muted); }
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
    .filter-field { display: flex; flex-direction: column; gap: 6px; }
    .filter-field label { font-size: 0.85rem; font-weight: 600; color: var(--academy-muted); }
    .filter-field input,
    .filter-field select {
      border-radius: 16px;
      border: 1px solid var(--academy-ghost-border);
      background: rgba(15, 23, 42, 0.02);
      padding: 10px 14px;
      font-size: 0.95rem;
      color: var(--academy-text);
    }
    .filter-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .filter-actions button {
      border-radius: 999px;
      border: 1px solid var(--academy-ghost-border);
      background: transparent;
      padding: 8px 18px;
      cursor: pointer;
      font-weight: 600;
      color: var(--academy-text);
    }
    .filter-actions button[data-active="true"] {
      background: var(--academy-cta);
      border-color: transparent;
      color: #fff;
    }
    .console-status { font-size: 0.9rem; color: var(--academy-muted); }

    .curriculum-shell {
      background: var(--academy-panel);
      border: 1px solid var(--academy-panel-border);
      border-radius: 32px;
      padding: clamp(24px, 4vw, 36px);
      box-shadow: var(--academy-shadow);
      display: grid;
      gap: 20px;
    }
    .curriculum-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      align-items: flex-end;
      justify-content: space-between;
    }
    .curriculum-toolbar__fields {
      flex: 1 1 420px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }
    .toolbar-field { display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: 0.85rem; color: var(--academy-muted); }
    .toolbar-field input,
    .toolbar-field select {
      border-radius: 16px;
      border: 1px solid var(--academy-ghost-border);
      padding: 10px 14px;
      background: rgba(15, 23, 42, 0.02);
      font-size: 0.95rem;
      color: var(--academy-text);
    }
    :root[data-theme="dark"] .toolbar-field input,
    :root[data-theme="dark"] .toolbar-field select,
    :root[data-theme^="system-dark"] .toolbar-field input,
    :root[data-theme^="system-dark"] .toolbar-field select {
      background: rgba(15, 23, 42, 0.75);
      border-color: rgba(148, 163, 184, 0.45);
      color: #e2e8f0;
    }
    :root[data-theme="dark"] .toolbar-field select option,
    :root[data-theme^="system-dark"] .toolbar-field select option {
      background: rgba(15, 23, 42, 0.9);
      color: #e2e8f0;
    }
    .curriculum-toolbar__actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .curriculum-btn {
      border-radius: 16px;
      border: 1px solid var(--academy-ghost-border);
      padding: 10px 18px;
      font-weight: 600;
      background: transparent;
      cursor: pointer;
      color: var(--academy-text);
      transition: transform 0.2s ease, border 0.2s ease;
    }
    .curriculum-btn--ghost { background: transparent; }
    .curriculum-btn[data-active="true"],
    .curriculum-btn--primary { background: var(--academy-cta); border-color: transparent; color: #fff; }
    .curriculum-btn--ghost:hover,
    .curriculum-btn--primary:hover { transform: translateY(-1px); }

    .curriculum-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .curriculum-item {
      border-radius: 24px;
      border: 1px solid var(--academy-panel-border);
      background: rgba(15, 23, 42, 0.01);
      overflow: hidden;
      transition: border 0.2s ease, box-shadow 0.2s ease;
    }
    .curriculum-item[data-open="true"] {
      border-color: rgba(37, 99, 235, 0.4);
      box-shadow: 0 25px 60px -45px rgba(15, 23, 42, 0.45);
      background: var(--academy-panel);
    }
    .curriculum-head {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) auto;
      gap: 12px;
      width: 100%;
      text-align: left;
      padding: 22px 26px;
      background: transparent;
      border: none;
      appearance: none;
      cursor: pointer;
      align-items: center;
    }
    .curriculum-head__info h3 { margin: 4px 0 0; font-size: 1.2rem; color: var(--academy-text); }
    .curriculum-unit { margin: 0; font-size: 0.9rem; color: var(--academy-muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .curriculum-head__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      justify-content: flex-end;
    }
    .curriculum-pill {
      border-radius: 999px;
      padding: 4px 12px;
      border: 1px solid var(--academy-ghost-border);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--academy-text);
    }
    .curriculum-pill--ghost { background: var(--academy-ghost); color: var(--academy-muted); }
    .curriculum-chevron { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--academy-ghost-border); display: grid; place-items: center; transition: transform 0.2s ease; flex-shrink: 0; }
    .curriculum-item[data-open="true"] .curriculum-chevron { transform: rotate(180deg); }
    .curriculum-head svg { width: 18px; height: 18px; }

    :root[data-theme="dark"] .curriculum-item {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(96, 165, 250, 0.35);
    }
    :root[data-theme="dark"] .curriculum-item[data-open="true"] {
      background: rgba(15, 23, 42, 0.75);
      border-color: rgba(14, 165, 233, 0.65);
      box-shadow: 0 35px 80px -45px rgba(2, 6, 23, 0.9);
    }
    :root[data-theme="dark"] .curriculum-head {
      background: rgba(148, 163, 184, 0.05);
      border-radius: 24px;
    }
    :root[data-theme="dark"] .curriculum-body {
      border-top-color: rgba(248, 250, 252, 0.12);
    }
    :root[data-theme="dark"] .curriculum-chevron {
      border-color: rgba(148, 163, 184, 0.4);
      background: rgba(148, 163, 184, 0.12);
    }
    :root[data-theme="dark"] .curriculum-chevron svg path {
      stroke: var(--academy-text);
    }
    :root[data-theme="dark"] .curriculum-actions .academy-btn:not(.academy-btn--primary) {
      border-color: rgba(14, 165, 233, 0.45);
      background: rgba(14, 165, 233, 0.2);
      color: var(--academy-text);
    }

    .curriculum-body { padding: 0 26px 24px; border-top: 1px solid rgba(15, 23, 42, 0.08); display: none; gap: 18px; }
    .curriculum-item[data-open="true"] .curriculum-body { display: grid; }
    .curriculum-summary { margin: 0; color: var(--academy-muted); line-height: 1.7; }
    .curriculum-coverage { display: flex; flex-wrap: wrap; gap: 8px; }
    .curriculum-tag { border-radius: 12px; padding: 4px 10px; background: var(--academy-ghost); font-size: 0.85rem; color: var(--academy-text); }
    .curriculum-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
    .curriculum-metric { border-radius: 18px; border: 1px dashed var(--academy-ghost-border); padding: 12px 14px; background: rgba(15, 23, 42, 0.015); }
    .curriculum-metric span { display: block; font-size: 0.78rem; color: var(--academy-muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .curriculum-metric strong { display: block; font-size: 1.1rem; color: var(--academy-muted); margin-top: 4px; }
    .curriculum-resources { display: grid; gap: 12px; }
    .curriculum-highlights { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
    .curriculum-highlights li { display: flex; gap: 8px; align-items: flex-start; color: var(--academy-muted); font-size: 0.92rem; }
    .curriculum-highlights li::before { content: "•"; color: var(--academy-accent); }
    .curriculum-tags { margin: 20px 0 0; }
    .curriculum-tags__label { margin: 0 0 8px; font-size: 0.85rem; color: var(--academy-muted); }
    .curriculum-tags__list { display: flex; flex-wrap: wrap; gap: 8px; }
    .curriculum-tags__list .curriculum-pill { margin: 0; }
    .curriculum-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .curriculum-actions .academy-btn { flex: 0 0 auto; padding: 12px 22px; border-radius: 999px; font-size: 0.95rem; box-shadow: 0 15px 35px -20px rgba(14, 165, 233, 0.8); }
    .curriculum-actions .academy-btn:not(.academy-btn--primary) { border-color: rgba(14, 165, 233, 0.35); color: var(--academy-text); background: rgba(14, 165, 233, 0.08); }
    .curriculum-actions .academy-btn--primary { background: linear-gradient(120deg, #0ea5e9, #2563eb); }
    .curriculum-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      border-top: 1px solid rgba(15, 23, 42, 0.08);
      padding-top: 16px;
    }
    .signal-head {
      display: flex;
      justify-content: center;
      text-align: center;
      padding: 0 clamp(8px, 3vw, 24px);
    }
    .signal-head h2 { margin: 0; }
    @media (max-width: 640px) {
      .signal-head {
        justify-content: center;
        padding: 0;
      }
    }
    .signal-counter { font-size: 0.9rem; color: var(--academy-muted); }
    .orbit-buttons { display: inline-flex; gap: 10px; }
    .orbit-buttons button {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      border: 1px solid var(--academy-ghost-border);
      background: transparent;
      color: var(--academy-text);
      cursor: pointer;
    }
    .orbit-buttons button:disabled { opacity: 0.4; cursor: not-allowed; }
    @media (max-width: 720px) {
      .curriculum-head { grid-template-columns: 1fr; }
      .curriculum-head__meta { justify-content: flex-start; }
    }

    .academy-catalog {
      background: linear-gradient(180deg, var(--academy-bg) 0%, #ffffff 60%);
      padding: clamp(36px, 8vw, 80px) 0;
    }
    .catalog-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(260px, 0.85fr);
      gap: clamp(28px, 5vw, 48px);
    }
    @media (max-width: 1100px) {
      .catalog-grid { grid-template-columns: 1fr; }
    }

    .catalog-main { display: grid; gap: 20px; }
    .catalog-head {
      background: var(--academy-panel);
      border: 1px solid var(--academy-panel-border);
      border-radius: 28px;
      padding: 24px 28px;
      box-shadow: var(--academy-shadow);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
    }
    .catalog-head h3 { margin: 0; color: var(--academy-text); font-size: 1.4rem; }
    .catalog-head p { margin: 0; color: var(--academy-muted); }

    .course-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: clamp(18px, 3vw, 28px);
    }
    .course-card {
      background: var(--academy-panel);
      border: 1px solid var(--academy-panel-border);
      border-radius: 24px;
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: 0 25px 60px -45px rgba(15, 23, 42, 0.4);
      transition: transform 0.2s ease, border 0.2s ease;
    }
    .course-card:hover { transform: translateY(-4px); border-color: rgba(37, 99, 235, 0.35); }
    .course-card__meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.85rem; color: var(--academy-muted); }
    .course-card__title { margin: 0; font-size: 1.2rem; color: var(--academy-text); }
    .course-card__summary { margin: 0; color: var(--academy-muted); line-height: 1.6; }
    .difficulty-pill {
      padding: 2px 10px;
      border-radius: 999px;
      background: var(--academy-accent-soft);
      color: var(--academy-accent);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .course-tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .course-tags span { font-size: 0.78rem; padding: 4px 10px; border-radius: 999px; background: var(--academy-ghost); color: var(--academy-text); }
    .course-card__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
    .course-card__actions button,
    .course-card__actions a {
      border-radius: 999px;
      border: 1px solid var(--academy-ghost-border);
      padding: 8px 16px;
      font-weight: 600;
      background: transparent;
      cursor: pointer;
      color: var(--academy-text);
    }
    .course-card__actions .primary { background: var(--academy-cta); border-color: transparent; color: #fff; }

    .academy-audio,
    .academy-references {
      border-radius: 18px;
      border: 1px solid var(--academy-ghost-border);
      background: rgba(15, 23, 42, 0.02);
      padding: 12px 14px;
      display: grid;
      gap: 0.6rem;
    }
    .academy-links { display: flex; flex-wrap: wrap; gap: 10px; }
    .academy-links a { text-decoration: none; }
    .academy-status { font-size: 0.9rem; color: var(--academy-muted); }

    .academy-btn {
      border-radius: 999px;
      border: 1px solid var(--academy-ghost-border);
      padding: 8px 16px;
      background: transparent;
      cursor: pointer;
      font-weight: 600;
      color: var(--academy-text);
    }
    .academy-btn--primary { background: var(--academy-cta); border-color: transparent; color: #fff; }

    .course-pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 8px;
    }
    .course-pagination__controls { display: inline-flex; gap: 8px; }
    .course-pagination__controls button {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      border: 1px solid var(--academy-ghost-border);
      background: var(--academy-panel);
      cursor: pointer;
    }
    .course-status { font-size: 0.9rem; color: var(--academy-muted); }

    .insight-rail { display: grid; gap: 20px; }
    .insight-card {
      background: var(--academy-panel);
      border: 1px solid var(--academy-panel-border);
      border-radius: 28px;
      padding: 22px;
      box-shadow: var(--academy-shadow);
      display: grid;
      gap: 18px;
    }
    .insight-card--primary {
      background: linear-gradient(160deg, rgba(37, 99, 235, 0.15), rgba(37, 99, 235, 0.05)), var(--academy-panel);
      border-color: rgba(37, 99, 235, 0.35);
    }
    .insight-card__head { display: grid; gap: 4px; }
    .signal-label { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--academy-accent); }
    .insight-card h4 { margin: 0; color: var(--academy-text); }
    .insight-card p { margin: 0; color: var(--academy-muted); }


    .resource-list,
    .trust-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
    .resource-list li,
    .trust-list li { display: flex; justify-content: space-between; align-items: center; font-size: 0.92rem; color: var(--academy-text); }
    .resource-list a { color: var(--academy-accent); text-decoration: none; font-weight: 600; }

    .academy-modal {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding: clamp(48px, 8vh, 96px) clamp(16px, 5vw, 40px);
      overflow-y: auto;
    }
    .academy-modal[data-open="true"] { display: flex; }
    .academy-modal__backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(10px);
    }
    .wealth-modal__head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    #academy-modal-title {
      margin: 0;
      font-size: 1.4rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--academy-text);
    }
    .academy-modal__panel {
      position: relative;
      width: min(960px, 92vw);
      max-height: min(92vh, 1080px);
      min-height: 0;
      overflow: hidden;
      border-radius: 32px;
      border: 1px solid rgba(148, 163, 184, 0.3);
      background: var(--academy-panel);
      color: var(--academy-text);
      padding: clamp(24px, 4vw, 36px);
      box-shadow: var(--academy-shadow);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .academy-modal__panel h3 { margin: 0; font-size: 1.6rem; }
    .academy-modal__panel .academy-status { color: var(--academy-muted); margin: 0; }
    .wealth-modal__body {
      display: grid;
      gap: 14px;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      padding-right: 4px;
    }
    .academy-modal__content {
      display: grid;
      gap: 1rem;
      line-height: 1.8;
      color: var(--academy-text);
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .academy-modal__content p,
    .academy-modal__content li,
    .academy-modal__content h1,
    .academy-modal__content h2,
    .academy-modal__content h3,
    .academy-modal__content h4,
    .academy-modal__content h5,
    .academy-modal__content h6 {
      margin: 0;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .academy-modal__content ul,
    .academy-modal__content ol { margin: 0; padding-left: 1.4rem; }
    .academy-modal__content li { margin-bottom: 0.4rem; }
    .academy-modal__content pre {
      margin: 0;
      padding: 14px 16px;
      border-radius: 18px;
      background: rgba(15, 23, 42, 0.08);
      font-size: 0.9rem;
      overflow-x: hidden;
      white-space: pre-wrap;
      word-break: break-word;
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    }
    .academy-modal__content code {
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      background: rgba(15, 23, 42, 0.06);
      padding: 2px 6px;
      border-radius: 6px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .academy-modal__content table,
    .curriculum-body table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.95rem;
      border-radius: 18px;
      overflow: hidden;
    }
    .academy-modal__content th,
    .academy-modal__content td,
    .curriculum-body th,
    .curriculum-body td {
      padding: 0.85rem 1rem;
      text-align: left;
      border: 1px solid rgba(148, 163, 184, 0.25);
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .academy-modal__content thead th,
    .curriculum-body thead th {
      background: rgba(37, 99, 235, 0.08);
      font-weight: 700;
      color: var(--academy-text);
    }
    .academy-modal__content tbody tr:nth-child(odd),
    .curriculum-body tbody tr:nth-child(odd) {
      background: rgba(15, 23, 42, 0.02);
    }
    .academy-modal__content tbody tr:nth-child(even),
    .curriculum-body tbody tr:nth-child(even) {
      background: rgba(15, 23, 42, 0.01);
    }
    .academy-modal__content tbody tr:hover,
    .curriculum-body tbody tr:hover {
      background: rgba(14, 165, 233, 0.08);
    }
    .academy-modal__content table caption,
    .curriculum-body table caption {
      text-align: left;
      font-weight: 600;
      margin-bottom: .5rem;
      color: var(--academy-muted);
    }
    :root[data-theme="dark"] .academy-modal__content pre {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(148, 163, 184, 0.35);
    }
    :root[data-theme="dark"] .academy-modal__content code {
      background: rgba(148, 163, 184, 0.22);
      color: var(--academy-text);
    }
    :root[data-theme="dark"] .academy-modal__content table,
    :root[data-theme="dark"] .curriculum-body table {
      border-color: rgba(148, 163, 184, 0.35);
    }
    :root[data-theme="dark"] .academy-modal__content thead th,
    :root[data-theme="dark"] .curriculum-body thead th {
      background: rgba(96, 165, 250, 0.16);
    }
    :root[data-theme="dark"] .academy-modal__content tbody tr:nth-child(odd),
    :root[data-theme="dark"] .curriculum-body tbody tr:nth-child(odd) {
      background: rgba(148, 163, 184, 0.08);
    }
    :root[data-theme="dark"] .academy-modal__content tbody tr:nth-child(even),
    :root[data-theme="dark"] .curriculum-body tbody tr:nth-child(even) {
      background: rgba(15, 23, 42, 0.45);
    }
    .academy-modal-audio {
      border-radius: 20px;
      border: 1px solid var(--academy-ghost-border);
      padding: 14px 16px;
      background: rgba(14, 165, 233, 0.08);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .academy-modal-audio audio {
      width: 100%;
      border-radius: 12px;
    }
    .academy-modal__footer {
      display: flex;
      justify-content: flex-end;
      padding-top: 12px;
      border-top: 1px solid rgba(15, 23, 42, 0.08);
    }
    .academy-modal__footer .academy-btn {
      border-radius: 999px;
      padding: 10px 20px;
      border: 1px solid var(--academy-ghost-border);
    }

    .academy-practice { display: grid; gap: 18px; }
    .academy-practice h4 { margin: 0; }
    .academy-practice__form { display: grid; gap: 16px; }
    .academy-practice__item {
      border-radius: 20px;
      border: 1px solid var(--academy-panel-border);
      padding: 18px;
      background: rgba(15, 23, 42, 0.02);
      display: grid;
      gap: 12px;
    }
    .academy-practice__item legend { font-weight: 600; margin-bottom: 4px; }
    .academy-practice__prompt { margin: 0; line-height: 1.7; color: var(--academy-text); }
    .academy-practice__option {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 14px;
      border: 1px solid transparent;
      background: #fff;
      color: var(--academy-text);
    }
    :root[data-theme="dark"] .academy-practice__option,
    :root[data-theme^="system-dark"] .academy-practice__option { background: rgba(148, 163, 184, 0.08); }
    .academy-practice__option input { margin-top: 4px; }
    .academy-practice__feedback { margin: 0; font-size: 0.9rem; color: var(--academy-muted); }
    .academy-practice__item input[type="text"] {
      border-radius: 14px;
      border: 1px solid var(--academy-ghost-border);
      padding: 8px 12px;
      font-size: 0.95rem;
      width: 100%;
    }
    .academy-practice__form button[type="submit"] {
      justify-self: start;
      padding: 12px 24px;
      border-radius: 999px;
    }
    .katex-display { margin: 12px 0; }

    .wealth-legal__card {
      border-radius: 24px;
      border: 1px solid var(--academy-panel-border);
    .academy-practice__feedback {
      font-size: 0.9rem;
      color: var(--academy-accent);
      margin: 0;
    }
      background: var(--academy-panel);
      color: var(--academy-text);
      box-shadow: var(--academy-shadow);
    }
  </style>
</head>
<body>
