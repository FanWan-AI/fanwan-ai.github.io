  <meta name="description" content="Explore AI-generated games and interactive entertainment." data-i18n-content="module_ai_game_desc">
  <link rel="canonical" href="https://fanwan-ai.github.io/lab/ai-game-center.html">
  <meta property="og:type" content="website">
  <meta property="og:title" content="AI 游戏中心 · AI Game Center" data-i18n-content="module_ai_game_title">
  <meta property="og:description" content="Explore AI-generated games and interactive entertainment." data-i18n-content="module_ai_game_desc">
  <meta property="og:image" content="https://fanwan-ai.github.io/assets/ai-lab/AI-CareerCoach.png">
  <meta property="og:url" content="https://fanwan-ai.github.io/lab/ai-game-center.html">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="AI 游戏中心 · AI Game Center" data-i18n-content="module_ai_game_title">
  <meta name="twitter:description" content="Explore AI-generated games and interactive entertainment." data-i18n-content="module_ai_game_desc">
  <meta name="twitter:image" content="https://fanwan-ai.github.io/assets/ai-lab/AI-CareerCoach.png">
  <script src="../lang-preload.js"></script>
  <script>
    (function(){
      try {
        var root = document.documentElement;
        if (!root) return;
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) { saved = null; }
        var hasManual = saved === 'light' || saved === 'dark';
        if (!hasManual && saved) {
          try { localStorage.removeItem('theme'); } catch (e2) {}
        }
        var prefersDark = false;
        try {
          prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch (e3) { prefersDark = false; }
        var theme = hasManual ? saved : (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);
        root.setAttribute('data-theme-mode', hasManual ? theme : ('system-' + theme));
        root.setAttribute('data-theme-source', hasManual ? 'user' : 'system');
      } catch(e){}
    })();
  </script>
  <style>
    html[data-lang-loading="true"] body { visibility: hidden; }
  </style>
  <link rel="stylesheet" href="../style.css">
  <script defer src="../lang.js"></script>
  <script defer src="../script.js"></script>
  <style>
    :root {
      --game-primary: #f59e0b;
      --game-primary-strong: #d97706;
      --game-primary-soft: rgba(245, 158, 11, 0.2);
      --game-secondary: #8b5cf6;
      --game-secondary-soft: rgba(139, 92, 246, 0.18);
      --game-accent: #ec4899;
      --game-text-primary: #0f172a;
      --game-text-secondary: #1f2937;
      --game-text-muted: #334155;
      --game-surface: #fffbeb;
      --game-panel-bg: rgba(255, 255, 255, 0.96);
      --game-panel-border: rgba(245, 158, 11, 0.22);
      --game-panel-shadow: 0 32px 64px -32px rgba(245, 158, 11, 0.18);
      --game-label-bg: rgba(254, 243, 199, 0.84);
    }

    .page-hero.game-hero {
      position: relative;
      background:
        radial-gradient(circle at 12% 18%, rgba(245, 158, 11, 0.24) 0%, transparent 58%),
        radial-gradient(circle at 86% 14%, rgba(139, 92, 246, 0.24) 0%, transparent 52%),
        radial-gradient(circle at 24% 80%, rgba(236, 72, 153, 0.22) 0%, transparent 60%),
        linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(139, 92, 246, 0.1) 55%, rgba(245, 158, 11, 0.15) 100%);
    }
    .page-hero.game-hero h1 {
      color: var(--game-text-primary);
    }
    .page-hero.game-hero .subtitle {
      color: var(--game-text-muted);
    }

    .game-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      padding: 4rem 0;
    }

    .game-card {
      background: var(--game-panel-bg);
      border: 1px solid var(--game-panel-border);
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex;
      flex-direction: column;
    }
    .game-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--game-panel-shadow);
    }
    .game-card-media {
      aspect-ratio: 16/9;
      background: #e5e7eb;
      position: relative;
      overflow: hidden;
    }
    .game-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .game-card-content {
      padding: 1.5rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .game-card-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--game-text-primary);
    }
    .game-card-desc {
      font-size: 0.95rem;
      color: var(--game-text-muted);
      margin-bottom: 1rem;
      flex: 1;
    }
    .game-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
    }
    .game-tag {
      font-size: 0.75rem;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      background: var(--game-label-bg);
      color: var(--game-primary-strong);
      font-weight: 600;
    }
  </style>
</head>
<body class="lab-page">
  <header>
    <nav class="navbar container">
      <a href="../index.html" class="brand" aria-label="Home">
        <img src="../assets/logo.svg" alt="Fan Wan logo" class="brand-logo" width="28" height="28" />
