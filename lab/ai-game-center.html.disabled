  <main id="main">
    <section class="page-hero game-hero section">
      <div class="bg-shapes">
        <span class="shape shape1"></span>
        <span class="shape shape2"></span>
        <span class="shape shape3"></span>
        <span class="shape shape4"></span>
      </div>
      <div class="container">
        <h1 data-i18n="module_ai_game_title">AI 游戏中心</h1>
        <p class="subtitle" data-i18n="module_ai_game_desc">探索 AI 生成的游戏世界，体验无限创意的互动娱乐。</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="game-grid">
          <!-- Game 1: Chinese Legend -->
          <article class="game-card">
            <div class="game-card-media">
              <!-- Placeholder image -->
              <div style="width:100%;height:100%;background:linear-gradient(45deg, #f59e0b, #d97706);display:flex;align-items:center;justify-content:center;color:white;font-size:3rem;">🐉</div>
            </div>
            <div class="game-card-content">
              <h3 class="game-card-title">
                <span class="i18n l-zh">小学语文大冒险</span>
                <span class="i18n l-en">Chinese Quest</span>
                <span class="i18n l-es">Misión China</span>
              </h3>
              <p class="game-card-desc">
                <span class="i18n l-zh">穿越时空，挑战古诗词与汉字怪兽，成为语文大师！</span>
                <span class="i18n l-en">Travel through time, challenge poetry and character monsters, and become a master of Chinese!</span>
                <span class="i18n l-es">¡Viaja en el tiempo, desafía a monstruos de poesía y caracteres, y conviértete en un maestro del chino!</span>
              </p>
              <div class="game-card-footer">
                <span class="game-tag">RPG</span>
                <a href="games/chinese-legend/index.html" class="btn primary small">
                  <span class="i18n l-zh">开始游戏</span>
                  <span class="i18n l-en">Play Now</span>
                  <span class="i18n l-es">Jugar</span>
                </a>
              </div>
            </div>
          </article>

          <!-- Game 2: Coming Soon -->
          <article class="game-card" style="opacity: 0.7;">
            <div class="game-card-media">
              <div style="width:100%;height:100%;background:linear-gradient(45deg, #8b5cf6, #6d28d9);display:flex;align-items:center;justify-content:center;color:white;font-size:3rem;">🧮</div>
            </div>
            <div class="game-card-content">
              <h3 class="game-card-title">
                <span class="i18n l-zh">数学英雄</span>
                <span class="i18n l-en">Math Hero</span>
                <span class="i18n l-es">Héroe Matemático</span>
              </h3>
              <p class="game-card-desc">
                <span class="i18n l-zh">用算术魔法击败敌人。</span>
                <span class="i18n l-en">Defeat enemies with arithmetic magic.</span>
                <span class="i18n l-es">Derrota enemigos con magia aritmética.</span>
              </p>
              <div class="game-card-footer">
                <span class="game-tag">Puzzle</span>
                <button class="btn outline small" disabled>Coming Soon</button>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

